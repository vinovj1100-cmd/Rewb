{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Order",
  "type": "object",
  "required": [
    "order_id",
    "customer_id",
    "status"
  ],
  "properties": {
    "order_id": {
      "type": "string",
      "pattern": "^ORD-[0-9]+$"
    },
    "customer_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "PICKING",
        "PACKED",
        "SHIPPED",
        "DELIVERED",
        "CANCELLED",
        "RETURNED"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "LOW",
        "NORMAL",
        "HIGH",
        "URGENT"
      ]
    },
    "total_items": {
      "type": "integer",
      "minimum": 0
    },
    "total_value": {
      "type": "number",
      "minimum": 0
    },
    "shipping_address": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "promised_date": {
      "type": "string",
      "format": "date-time"
    },
    "carrier": {
      "type": "string"
    },
    "tracking_number": {
      "type": "string"
    }
  }
}