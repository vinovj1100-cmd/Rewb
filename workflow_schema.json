{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow",
  "type": "object",
  "required": [
    "workflow_id",
    "name",
    "current_state"
  ],
  "properties": {
    "workflow_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "current_state": {
      "type": "string",
      "enum": [
        "INIT",
        "PENDING",
        "PICKING",
        "PICKED",
        "PACKING",
        "PACKED",
        "SHIPPING",
        "SHIPPED",
        "DELIVERED",
        "CANCELLED",
        "ON_HOLD",
        "RETURNED"
      ]
    },
    "context": {
      "type": "object"
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      }
    }
  }
}