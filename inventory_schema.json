{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "InventoryItem",
  "type": "object",
  "required": [
    "sku",
    "quantity",
    "location"
  ],
  "properties": {
    "sku": {
      "type": "string",
      "pattern": "^[A-Z]{3,4}-[0-9]+$"
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "location": {
      "type": "string",
      "pattern": "^[A-D]-[0-9]{2}$"
    },
    "quantity": {
      "type": "integer",
      "minimum": 0
    },
    "reserved": {
      "type": "integer",
      "minimum": 0
    },
    "reorder_point": {
      "type": "integer",
      "minimum": 0
    },
    "max_stock": {
      "type": "integer",
      "minimum": 1
    },
    "unit_cost": {
      "type": "number",
      "minimum": 0
    },
    "category": {
      "type": "string",
      "enum": [
        "Electronics",
        "Mechanical",
        "Textiles",
        "Food",
        "Chemicals",
        "Automotive",
        "Home",
        "Sports"
      ]
    },
    "zone": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "aisle": {
      "type": "string"
    },
    "bin": {
      "type": "string"
    }
  }
}